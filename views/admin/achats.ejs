<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/head') %>
    <title>RON OIL Admin — Achats</title>
    <link rel="stylesheet" href="/css/admin-shared.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <style>
        .type-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
        .type-row {
            display: flex; align-items: center; gap: 10px;
            padding: 10px 14px;
            background: var(--bg-card); border: 1px solid var(--border);
        }
        .type-row-name {
            flex: 1; font-size: 14px; font-weight: 500;
        }
        .type-row-input {
            flex: 1; background: var(--bg-input); border: 1px solid var(--border);
            color: var(--text-primary); font-family: var(--font-body); font-size: 14px;
            padding: 6px 10px; outline: none;
        }
        .type-row-input:focus { border-color: var(--accent); }
        .type-row-actions { display: flex; gap: 6px; }
        .type-add-row {
            display: flex; gap: 10px; align-items: center;
        }
        .type-add-row .f-input { flex: 1; }
        .select-with-manage {
            display: flex; gap: 8px; align-items: flex-end;
        }
        .select-with-manage > div:first-child { flex: 1; }
        .btn-manage-types {
            background: rgba(255,255,255,.05); border: 1px solid var(--border);
            color: var(--text-secondary); cursor: pointer; padding: 10px 14px;
            font-size: 14px; transition: all .15s; flex-shrink: 0;
            height: 42px; display: flex; align-items: center;
        }
        .btn-manage-types:hover { border-color: rgba(255,255,255,.15); color: var(--text-primary); }
    </style>
</head>
<body>
    <%- include('../partials/admin-sidebar', { currentPage: 'achats' }) %>
    <main class="main-content">
        <div class="page-header">
            <div class="page-title">Achats</div>
            <div class="page-subtitle">Enregistrement et suivi des d&eacute;penses</div>
        </div>

        <div class="g4" style="margin-bottom:28px;">
            <div class="card"><div class="card-label">Total achats</div><div class="card-value c-accent"><%= counters.total %></div></div>
            <div class="card"><div class="card-label">Total d&eacute;pens&eacute;</div><div class="card-value c-gold"><%= counters.totalSpent.toFixed(2) %>$</div></div>
            <div class="card"><div class="card-label">Semaine actuelle</div><div class="card-value">S<%= currentWeek %></div></div>
            <div class="card"><div class="card-label">D&eacute;penses S<%= currentWeek %></div><div class="card-value"><%= counters.weekTotal.toFixed(2) %>$</div></div>
        </div>

        <form class="admin-toolbar" method="GET" action="/admin/achats">
            <div class="admin-toolbar-left">
                <input type="text" class="admin-search" name="q" placeholder="Rechercher..." value="<%= query.q %>">
                <% if (query.q) { %>
                    <a href="/admin/achats" style="font-size:13px;color:var(--text-muted);text-decoration:none;">R&eacute;initialiser</a>
                <% } %>
            </div>
            <button type="button" class="btn-add" onclick="openAddPurchase()">
                <i class="fa-solid fa-plus"></i> Enregistrer un achat
            </button>
        </form>

        <div class="card" style="padding:0;overflow:hidden;">
            <div class="table-scroll">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Semaine</th>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Effectu&eacute; par</th>
                        <th>Qt&eacute;</th>
                        <th>Prix unitaire</th>
                        <th>Total</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="achats-body">
                    <% if (purchases.length === 0) { %>
                        <tr><td colspan="10" style="text-align:center;padding:40px;color:var(--text-muted)">Aucun r&eacute;sultat</td></tr>
                    <% } %>
                    <% purchases.forEach(function(a) { %>
                    <% const name = (a.employeeId || a.employeeFirstName) ? empName(a) : null; %>
                    <tr class="achat-row" data-achat-id="<%= a.id %>">
                        <td class="mono" style="color:var(--text-muted)"><%= a.id %></td>
                        <td><span style="font-family:var(--font-mono);font-size:13px;color:var(--accent)">S<%= a.week %></span></td>
                        <td class="mono" style="color:var(--text-secondary);font-size:11px"><%= new Date(a.date).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' }) %></td>
                        <td><%= a.typeRef ? a.typeRef.label : '—' %></td>
                        <td style="color:var(--text-secondary)"><%= name || '—' %><% if (name && !a.employee) { %> <span style="font-size:10px;color:var(--text-muted);font-style:italic">(supprimé)</span><% } %></td>
                        <td class="mono"><%= a.qty %></td>
                        <td class="mono"><%= a.unitPrice.toFixed(2) %>$</td>
                        <td class="mono" style="color:var(--gold);font-weight:600"><%= (a.qty * a.unitPrice).toFixed(2) %>$</td>
                        <td style="color:var(--text-secondary);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="<%= a.description %>"><%= a.description %></td>
                        <td>
                            <div class="table-actions">
                                <button type="button" class="btn-edit" onclick="editPurchase(<%= a.id %>)" title="Modifier"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="btn-delete" onclick="deletePurchase(<%= a.id %>)" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            </div>
            <%- include('../partials/pagination', { page, totalPages, total, query }) %>
        </div>
    </main>

    <!-- Modal Ajouter achat -->
    <div class="modal-overlay" id="modal-add">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Enregistrer un achat</div>
                <button class="modal-close" onclick="closeModal('modal-add')">&#10005;</button>
            </div>
            <form method="POST" action="/admin/achats">
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group-full">
                            <label class="f-label f-required">Type d'achat</label>
                            <div class="select-with-manage">
                                <div>
                                    <select class="f-select" name="typeKey" id="add-type" required>
                                        <option value="" disabled selected>S&eacute;lectionner...</option>
                                        <% types.forEach(function(t) { %>
                                        <option value="<%= t.key %>"><%= t.label %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <a class="btn-manage-types" href="/admin/types" title="G&eacute;rer les types" style="text-decoration:none;">
                                    <i class="fa-solid fa-gear"></i>
                                </a>
                            </div>
                        </div>
                        <div>
                            <label class="f-label f-required">Effectu&eacute; par</label>
                            <select class="f-select" name="employeeId" required>
                                <option value="" disabled selected>S&eacute;lectionner...</option>
                                <% employees.forEach(function(e) { %>
                                <option value="<%= e.id %>"><%= e.firstName %> <%= e.lastName %> &middot; <%= e.role %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">Quantit&eacute;</label>
                            <input type="number" class="f-input" name="qty" placeholder="0" min="1" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Prix unitaire ($)</label>
                            <input type="number" class="f-input" name="unitPrice" placeholder="0.00" step="0.01" min="0" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Date &amp; heure</label>
                            <input type="datetime-local" class="f-input" name="date" id="add-purchase-date" required>
                            <div style="margin-top:4px;font-size:12px;color:var(--text-muted)">
                                Semaine calcul&eacute;e : <strong id="add-purchase-week" style="color:var(--accent)">—</strong>
                            </div>
                        </div>
                        <div class="form-group-full">
                            <label class="f-label f-required">Description</label>
                            <textarea class="f-textarea" name="description" placeholder="D&eacute;crivez l'achat en d&eacute;tail..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('modal-add')">Annuler</button>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-check"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Modifier achat -->
    <div class="modal-overlay" id="modal-edit">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Modifier un achat</div>
                <button class="modal-close" onclick="closeModal('modal-edit')">&#10005;</button>
            </div>
            <form method="POST" id="form-edit" action="">
                <div class="modal-body">
                    <div class="form-grid">
                        <div class="form-group-full">
                            <label class="f-label f-required">Type d'achat</label>
                            <select class="f-select" name="typeKey" id="edit-type" required>
                                <option value="" disabled>S&eacute;lectionner...</option>
                                <% types.forEach(function(t) { %>
                                <option value="<%= t.key %>"><%= t.label %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">Effectu&eacute; par</label>
                            <select class="f-select" name="employeeId" id="edit-employee" required>
                                <option value="" disabled>S&eacute;lectionner...</option>
                                <% employees.forEach(function(e) { %>
                                <option value="<%= e.id %>"><%= e.firstName %> <%= e.lastName %> &middot; <%= e.role %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">Quantit&eacute;</label>
                            <input type="number" class="f-input" name="qty" id="edit-qty" placeholder="0" min="1" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Prix unitaire ($)</label>
                            <input type="number" class="f-input" name="unitPrice" id="edit-unitPrice" placeholder="0.00" step="0.01" min="0" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Date &amp; heure</label>
                            <input type="datetime-local" class="f-input" name="date" id="edit-purchase-date" required>
                            <div style="margin-top:4px;font-size:12px;color:var(--text-muted)">
                                Semaine calcul&eacute;e : <strong id="edit-purchase-week" style="color:var(--accent)">—</strong>
                            </div>
                        </div>
                        <div class="form-group-full">
                            <label class="f-label f-required">Description</label>
                            <textarea class="f-textarea" name="description" id="edit-description" placeholder="D&eacute;crivez l'achat en d&eacute;tail..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('modal-edit')">Annuler</button>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-check"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- (Gestion des types : centralis&eacute;e sur /admin/types, accessible via l'ic&ocirc;ne d'engrenage dans le modal d'ajout) -->

    <div class="toast success" id="toast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toast-msg">Action effectu&eacute;e</span>
    </div>

    <script src="/js/week.js"></script>
    <script src="/js/admin-ajax.js"></script>
    <script>
        function deletePurchase(id) {
            showConfirm({
                title: 'Supprimer l\'achat',
                message: 'Supprimer cet achat ?',
                variant: 'danger',
            }).then(function(ok) {
                if (!ok) return;
                AdminAjax.post('/admin/achats/' + id + '/delete')
                    .then(function() { return AdminAjax.reloadMain(); })
                    .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
            });
        }

        (function() {
            var form = document.querySelector('#modal-add form');
            if (!form) return;
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                AdminAjax.postForm(form).then(function() {
                    closeModal('modal-add');
                    form.reset();
                    showToast('Achat enregistré');
                    return AdminAjax.reloadMain();
                }).catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
            });
        })();

        // Format YYYY-MM-DDTHH:MM en HEURE LOCALE (compatible <input type="datetime-local">).
        function toLocalDatetimeInput(d) {
            return d.getFullYear() + '-'
                + String(d.getMonth() + 1).padStart(2, '0') + '-'
                + String(d.getDate()).padStart(2, '0') + 'T'
                + String(d.getHours()).padStart(2, '0') + ':'
                + String(d.getMinutes()).padStart(2, '0');
        }

        // Affichage en direct de la semaine à partir de la date+heure saisie (ISO + offset 6h)
        function attachLiveWeek(inputId, outId) {
            var input = document.getElementById(inputId);
            var out = document.getElementById(outId);
            if (!input || !out || !window.ronWeek) return;
            function refresh() {
                if (!input.value) { out.textContent = '—'; return; }
                // input.value au format YYYY-MM-DDTHH:MM (heure locale) → new Date l'interprète comme local.
                var w = window.ronWeek.getWeekFromTimestamp(new Date(input.value));
                out.textContent = 'S' + w;
            }
            input.addEventListener('input', refresh);
            refresh();
        }
        attachLiveWeek('add-purchase-date', 'add-purchase-week');
        attachLiveWeek('edit-purchase-date', 'edit-purchase-week');

        // Pré-remplit la date+heure de création à "maintenant" et ré-ouvre le modal.
        // Appelé à chaque ouverture (bouton + lien depuis le modal "Gérer les types")
        // → la date affichée reste toujours actuelle, et survit à form.reset() après
        // une création réussie.
        function openAddPurchase() {
            var input = document.getElementById('add-purchase-date');
            if (input) {
                input.value = toLocalDatetimeInput(new Date());
                input.dispatchEvent(new Event('input'));
            }
            openModal('modal-add');
        }

        // ── Édition d'un achat ──
        // Pas d'injection JSON : on fetch le détail à la demande pour que ça
        // reste viable même avec des dizaines de milliers d'achats.
        function editPurchase(id) {
            fetch('/admin/achats/' + id, { credentials: 'same-origin', headers: { Accept: 'application/json' } })
                .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function(r) {
                    var form = document.getElementById('form-edit');
                    form.action = '/admin/achats/' + id + '/edit';
                    form.typeKey.value = r.typeKey != null ? String(r.typeKey) : '';
                    form.employeeId.value = r.employeeId != null ? String(r.employeeId) : '';
                    form.qty.value = r.qty != null ? r.qty : '';
                    form.unitPrice.value = r.unitPrice != null ? r.unitPrice : '';
                    form.description.value = r.description || '';
                    // Date stockée en ISO (UTC) — reformatée en YYYY-MM-DDTHH:MM local.
                    form.date.value = toLocalDatetimeInput(new Date(r.date));
                    form.date.dispatchEvent(new Event('input'));
                    openModal('modal-edit');
                })
                .catch(function() { showToast('Achat introuvable', 'error'); });
        }

        document.getElementById('form-edit').addEventListener('submit', function(e) {
            e.preventDefault();
            AdminAjax.postForm(e.target).then(function() {
                closeModal('modal-edit');
                showToast('Achat modifié');
                return AdminAjax.reloadMain();
            }).catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        });

        // (La gestion des types — création, renommage, archivage, catégorie,
        // scope frais/achats — est centralisée sur /admin/types.)

        function openModal(id) {
            var overlay = document.getElementById(id);
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            var overlay = document.getElementById(id);
            overlay.classList.remove('open');
            document.body.style.overflow = '';
        }

        function showToast(msg, type) {
            type = type || 'success';
            var t = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            t.className = 'toast ' + type + ' show';
            setTimeout(function() { t.classList.remove('show'); }, 3500);
        }

        // Outside-click-to-close modals
        document.querySelectorAll('.modal-overlay').forEach(function(overlay) {
            var downTarget = null;
            overlay.addEventListener('mousedown', function(e) { downTarget = e.target; });
            overlay.addEventListener('mouseup', function(e) {
                if (downTarget === overlay && e.target === overlay) {
                    overlay.classList.remove('open');
                    document.body.style.overflow = '';
                }
                downTarget = null;
            });
        });

    </script>
    <script src="/js/search-autosubmit.js"></script>
    <script src="/js/auto-refresh.js"></script>
</body>
</html>
