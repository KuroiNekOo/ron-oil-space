<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/head') %>
    <title>RON OIL Admin — Salari&eacute;s</title>
    <link rel="stylesheet" href="/css/admin-shared.css">
</head>
<body>
    <%- include('../partials/admin-sidebar', { currentPage: 'salaries' }) %>
    <main class="main-content">
        <div class="page-header">
            <div class="page-title">Salari&eacute;s</div>
            <div class="page-subtitle">Gestion des employ&eacute;s Ron Oil</div>
        </div>

        <div class="g4" style="margin-bottom:28px;">
            <div class="card"><div class="card-label">Total employ&eacute;s</div><div class="card-value c-accent"><%= counters.total %></div></div>
            <div class="card"><div class="card-label">CDI</div><div class="card-value"><%= counters.cdi %></div></div>
            <div class="card"><div class="card-label">CDD</div><div class="card-value c-gold"><%= counters.cdd %></div></div>
            <div class="card"><div class="card-label">Inactifs</div><div class="card-value"><%= counters.inactive %></div></div>
        </div>

        <%
            const _absTypes = { conge: 'Congé', maladie: 'Maladie', accident: 'Accident', perso: 'Personnel', autre: 'Autre' };
            const _fmtFr = d => new Date(d).toLocaleDateString('fr-FR');
            const _totalAbsCards = absenceCards.ongoing.length + absenceCards.upcoming.length + absenceCards.endingSoon.length;
        %>
        <% if (_totalAbsCards > 0 || autoDeactivate !== undefined) { %>
        <section class="absence-strip">
            <div class="absence-strip-header">
                <div class="absence-strip-title">
                    <i class="fa-solid fa-user-clock"></i>
                    Places à remplacer
                    <% if (_totalAbsCards > 0) { %>
                        <span class="absence-strip-count"><%= _totalAbsCards %></span>
                    <% } %>
                </div>
                <label class="absence-toggle" title="Désactiver automatiquement le compte de l'employé à la date de début de son absence">
                    <input type="checkbox" id="toggle-auto-deactivate"<%= autoDeactivate ? ' checked' : '' %>>
                    <span class="absence-toggle-slider"></span>
                    <span class="absence-toggle-label">Désactivation auto à l'absence</span>
                </label>
            </div>
            <% if (_totalAbsCards === 0) { %>
                <div class="absence-strip-empty">Aucune absence en cours ou à venir.</div>
            <% } else { %>
            <div class="absence-cards">
                <% absenceCards.ongoing.forEach(function(a) { %>
                    <div class="abs-card abs-ongoing" data-bucket="ongoing"
                         data-absence-id="<%= a.id %>"
                         data-employee-id="<%= a.employeeId %>"
                         data-employee-name="<%= a.employeeName %>"
                         data-date-start="<%= a.dateStart.toISOString() %>"
                         data-date-end="<%= a.dateEnd.toISOString() %>">
                        <div class="abs-card-badge">EN COURS</div>
                        <div class="abs-card-name"><%= a.employeeName %></div>
                        <div class="abs-card-type"><%= _absTypes[a.type] || a.type %></div>
                        <div class="abs-card-dates"><%= _fmtFr(a.dateStart) %> → <%= _fmtFr(a.dateEnd) %></div>
                        <button type="button" class="abs-card-btn" onclick="openReplaceModalFromCard(this)">
                            <i class="fa-solid fa-user-plus"></i> Cr&eacute;er rempla&ccedil;ant
                        </button>
                    </div>
                <% }); %>
                <% absenceCards.upcoming.forEach(function(a) { %>
                    <div class="abs-card abs-upcoming" data-bucket="upcoming"
                         data-absence-id="<%= a.id %>"
                         data-employee-id="<%= a.employeeId %>"
                         data-employee-name="<%= a.employeeName %>"
                         data-date-start="<%= a.dateStart.toISOString() %>"
                         data-date-end="<%= a.dateEnd.toISOString() %>">
                        <div class="abs-card-badge">À VENIR</div>
                        <div class="abs-card-name"><%= a.employeeName %></div>
                        <div class="abs-card-type"><%= _absTypes[a.type] || a.type %></div>
                        <div class="abs-card-dates"><%= _fmtFr(a.dateStart) %> → <%= _fmtFr(a.dateEnd) %></div>
                        <button type="button" class="abs-card-btn" onclick="openReplaceModalFromCard(this)">
                            <i class="fa-solid fa-user-plus"></i> Cr&eacute;er rempla&ccedil;ant
                        </button>
                    </div>
                <% }); %>
                <% absenceCards.endingSoon.forEach(function(a) { %>
                    <div class="abs-card abs-ending-soon" data-bucket="endingSoon"
                         data-absence-id="<%= a.id %>"
                         data-employee-id="<%= a.employeeId %>"
                         data-employee-name="<%= a.employeeName %>"
                         data-employee-status="<%= a.employeeStatus %>"
                         data-date-start="<%= a.dateStart.toISOString() %>"
                         data-date-end="<%= a.dateEnd.toISOString() %>">
                        <div class="abs-card-badge">SE TERMINE BIENT&Ocirc;T</div>
                        <div class="abs-card-name"><%= a.employeeName %></div>
                        <div class="abs-card-type"><%= _absTypes[a.type] || a.type %></div>
                        <div class="abs-card-dates">jusqu'au <%= _fmtFr(a.dateEnd) %></div>
                        <% if (a.employeeStatus === 'inactive') { %>
                            <button type="button" class="abs-card-btn abs-btn-reactivate" onclick="reactivateFromCard(this)">
                                <i class="fa-solid fa-user-check"></i> R&eacute;activer le compte
                            </button>
                        <% } else { %>
                            <div class="abs-card-note">Compte actif &mdash; rien à faire au retour.</div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
            <% } %>
        </section>
        <% } %>

        <form class="admin-toolbar" method="GET" action="/admin/salaries">
            <div class="admin-toolbar-left" style="flex-wrap:wrap;gap:10px;">
                <input type="text" class="admin-search" name="q" placeholder="Rechercher un salari&eacute;..." value="<%= query.q %>">
                <select class="f-select toolbar-select" name="duty" title="Filtrer par service">
                    <option value="all"<%= query.duty === 'all' ? ' selected' : '' %>>Tous les statuts</option>
                    <option value="on"<%= query.duty === 'on' ? ' selected' : '' %>>En service</option>
                    <option value="off"<%= query.duty === 'off' ? ' selected' : '' %>>Hors service</option>
                </select>
                <select class="f-select toolbar-select" name="sort" title="Trier le tableau">
                    <option value="default"<%= query.sort === 'default' ? ' selected' : '' %>>Tri par d&eacute;faut</option>
                    <option value="name-asc"<%= query.sort === 'name-asc' ? ' selected' : '' %>>Nom A &rarr; Z</option>
                    <option value="name-desc"<%= query.sort === 'name-desc' ? ' selected' : '' %>>Nom Z &rarr; A</option>
                    <option value="hire-desc"<%= query.sort === 'hire-desc' ? ' selected' : '' %>>Embauche r&eacute;cente</option>
                    <option value="hire-asc"<%= query.sort === 'hire-asc' ? ' selected' : '' %>>Embauche ancienne</option>
                </select>
                <% if (query.q || query.duty !== 'all' || query.sort !== 'default') { %>
                    <a href="/admin/salaries" class="toolbar-reset-link" title="R&eacute;initialiser"><i class="fa-solid fa-rotate-left"></i> R&eacute;initialiser</a>
                <% } %>
            </div>
            <button type="button" class="btn-add" onclick="openModal('modal-add')">
                <i class="fa-solid fa-plus"></i> Ajouter un salari&eacute;
            </button>
        </form>

        <div class="card" style="padding:0;overflow:hidden;">
            <table class="admin-table" id="salaries-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nom</th>
                        <th>Contrat</th>
                        <th>Poste</th>
                        <th>Statut</th>
                        <th>Admin</th>
                        <th>Embauche</th>
                        <th>T&eacute;l&eacute;phone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="salaries-body">
                    <% if (employees.length === 0) { %>
                        <tr><td colspan="9" style="text-align:center;padding:40px;color:var(--text-muted)">Aucun r&eacute;sultat</td></tr>
                    <% } %>
                    <% employees.forEach(function(e, i) { %>
                    <tr class="employee-row" data-employee-id="<%= e.id %>">
                        <td class="mono" style="color:var(--text-muted)"><%= pageOffset + i + 1 %></td>
                        <td style="font-weight:500">
                            <% var dutyClass = (e.duty && e.duty.onDuty) ? 'on' : 'off'; %>
                            <% var dutyTitle = e.duty ? ((e.duty.onDuty ? 'En service' : 'Hors service') + ' depuis ' + new Date(e.duty.since).toLocaleString('fr-FR')) : 'Hors service (aucun log)'; %>
                            <span class="duty-dot <%= dutyClass %>" title="<%= dutyTitle %>"></span>
                            <%
                                // Pastille statut contrat (gris=aucun, bleu=pending, orange=partiel, vert=signé)
                                let cDot = 'none', cLbl = 'Aucun contrat';
                                if (e.latestContract) {
                                    const s = e.latestContract.status;
                                    if (s === 'pending') { cDot = 'pending'; cLbl = 'Contrat en attente de signature employé'; }
                                    else if (s === 'employee-signed') { cDot = 'partial'; cLbl = 'Contrat signé par l\'employé, en attente direction'; }
                                    else if (s === 'company-signed') { cDot = 'partial'; cLbl = 'Signé par employé + direction, en attente avocat'; }
                                    else if (s === 'signed') { cDot = 'signed'; cLbl = 'Contrat finalisé'; }
                                }
                            %>
                            <span class="contract-dot <%= cDot %>" title="<%= cLbl %>"></span>
                            <a href="#" class="employee-name-link" onclick="event.preventDefault(); openRecap(<%= e.id %>)" title="Voir le récap"><%= e.firstName %> <%= e.lastName %></a>
                            <% if (e.replacesId || e.replacesLastName) {
                                 const _repName = (e.replacesFirstName || '') + ' ' + (e.replacesLastName || '');
                            %>
                                <span class="replaces-badge" title="Remplace <%= _repName.trim() %>">
                                    <i class="fa-solid fa-arrow-right-arrow-left"></i> <%= _repName.trim() %>
                                </span>
                            <% } %>
                        </td>
                        <td><span class="contract-badge <%= e.contract.toLowerCase() %>"><%= e.contract %></span></td>
                        <td><%= e.role %></td>
                        <td><span class="status-badge <%= e.status === 'active' ? 'active' : 'inactive' %>"><%= e.status === 'active' ? 'Actif' : 'Inactif' %></span></td>
                        <td>
                            <button type="button" class="btn-toggle-admin" onclick="toggleAdmin(<%= e.id %>)" title="<%= e.isAdmin ? 'Révoquer l’accès admin' : 'Donner l’accès admin' %>" style="background:none;border:none;cursor:pointer;padding:0;font-size:16px;color:<%= e.isAdmin ? '#ffb020' : 'var(--text-muted)' %>">
                                <i class="fa-solid <%= e.isAdmin ? 'fa-shield-halved' : 'fa-shield' %>"></i>
                            </button>
                        </td>
                        <td class="mono" style="color:var(--text-secondary)"><%= e.hireDate ? new Date(e.hireDate).toLocaleDateString('fr-FR') : '—' %></td>
                        <td class="mono" style="color:var(--text-secondary)"><%= e.phone || '—' %></td>
                        <td>
                            <div class="table-actions">
                                <% if (e.renewUrgency && e.renewUrgency !== 'none') { %>
                                    <button type="button" class="btn-renew btn-renew-<%= e.renewUrgency %>"
                                            onclick="openRenewModal(<%= e.id %>)"
                                            title="Renouveler le contrat (<%= e.renewUrgency === 'red' ? 'urgent' : (e.renewUrgency === 'orange' ? 'bientôt' : 'à anticiper') %>)">
                                        <i class="fa-solid fa-arrows-rotate"></i>
                                    </button>
                                <% } else if (!e.latestContract) { %>
                                    <button type="button" class="btn-renew btn-renew-none"
                                            onclick="generateContract(<%= e.id %>)"
                                            title="Générer un contrat (aucun contrat en BDD)">
                                        <i class="fa-solid fa-file-circle-plus"></i>
                                    </button>
                                <% } %>
                                <button class="btn-edit" onclick="editEmployee(<%= e.id %>)" title="Modifier"><i class="fa-solid fa-pen"></i></button>
                                <button type="button" class="btn-toggle-status" onclick="toggleStatus(<%= e.id %>)" title="<%= e.status === 'active' ? 'Désactiver' : 'Réactiver' %>">
                                    <i class="fa-solid <%= e.status === 'active' ? 'fa-user-slash' : 'fa-user-check' %>"></i>
                                </button>
                                <button type="button" class="btn-delete" onclick="deleteEmployee(<%= e.id %>)" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <%- include('../partials/pagination', { page, totalPages, total, query }) %>
        </div>
    </main>

    <!-- Modal Ajouter -->
    <%
        const _pad = n => String(n).padStart(2, '0');
        const _fmtIso = d => d.getFullYear() + '-' + _pad(d.getMonth() + 1) + '-' + _pad(d.getDate());
        const _today = new Date();
        const _todayIso = _fmtIso(_today);
        const _todayPlus21Iso = _fmtIso(new Date(_today.getTime() + 21 * 86400000));
    %>
    <div class="modal-overlay" id="modal-add">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Ajouter un salari&eacute;</div>
                <button class="modal-close" onclick="closeModal('modal-add')">&#10005;</button>
            </div>
            <form method="POST" action="/admin/salaries">
                <div class="modal-body">
                    <div class="form-grid">
                        <div>
                            <label class="f-label f-required">Pr&eacute;nom</label>
                            <input type="text" class="f-input" name="firstName" placeholder="Pr&eacute;nom" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Nom</label>
                            <input type="text" class="f-input" name="lastName" placeholder="Nom" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Contrat</label>
                            <select class="f-select" name="contract" required>
                                <option value="CDI">CDI</option>
                                <option value="CDD" selected>CDD</option>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">Poste</label>
                            <select class="f-select" name="role" required>
                                <% roles.forEach(function(r) { %>
                                    <option value="<%= r.name %>"<%= r.name === 'Livreur' ? ' selected' : '' %>><%= r.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">T&eacute;l&eacute;phone</label>
                            <input type="text" class="f-input" name="phone" placeholder="555-0000" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Date d'embauche</label>
                            <input type="date" class="f-input" name="hireDate" value="<%= _todayIso %>" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Date de fin de contrat</label>
                            <input type="date" class="f-input" name="endDate" value="<%= _todayPlus21Iso %>" required>
                        </div>
                        <div>
                            <label class="f-label">IBAN</label>
                            <input type="text" class="f-input" name="iban" placeholder="IBAN de l'employ&eacute;">
                        </div>
                        <div>
                            <label class="f-label f-required">ID Discord</label>
                            <input type="text" class="f-input" name="discordId" placeholder="ex. 123456789012345678" required>
                        </div>
                        <div class="form-group-full">
                            <label class="f-label">Remplace (optionnel)</label>
                            <select class="f-select" name="replacesId">
                                <option value="">— Personne —</option>
                                <% replaceCandidates.forEach(function(c) { %>
                                    <option value="<%= c.id %>"><%= c.lastName %> <%= c.firstName %><%= c.status === 'inactive' ? ' (inactif)' : '' %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group-full">
                            <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;">
                                <input type="checkbox" name="showInTeam" value="on" checked>
                                <span style="font-size:13px;color:var(--text-secondary);">Afficher sur la page publique <strong>/equipe</strong></span>
                            </label>
                        </div>
                        <div class="form-group-full">
                            <label class="f-label">Notes</label>
                            <textarea class="f-textarea" name="notes" placeholder="Informations compl&eacute;mentaires sur l'employ&eacute;..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('modal-add')">Annuler</button>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-check"></i> Ajouter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Modifier -->
    <div class="modal-overlay" id="modal-edit">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title">Modifier un salari&eacute;</div>
                <button class="modal-close" onclick="closeModal('modal-edit')">&#10005;</button>
            </div>
            <form method="POST" id="form-edit" action="">
                <div class="modal-body">
                    <div class="form-grid">
                        <div>
                            <label class="f-label f-required">Pr&eacute;nom</label>
                            <input type="text" class="f-input" name="firstName" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Nom</label>
                            <input type="text" class="f-input" name="lastName" required>
                        </div>
                        <div>
                            <label class="f-label f-required">Contrat</label>
                            <select class="f-select" name="contract" required>
                                <option value="CDI">CDI</option>
                                <option value="CDD">CDD</option>
                            </select>
                        </div>
                        <div>
                            <label class="f-label f-required">Poste</label>
                            <select class="f-select" name="role" required>
                                <% roles.forEach(function(r) { %>
                                    <option value="<%= r.name %>"><%= r.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="f-label">T&eacute;l&eacute;phone</label>
                            <input type="text" class="f-input" name="phone" placeholder="555-0000">
                        </div>
                        <div>
                            <label class="f-label f-required">Date d'embauche</label>
                            <input type="date" class="f-input" name="hireDate" required>
                        </div>
                        <div>
                            <label class="f-label">Date de fin de contrat</label>
                            <input type="date" class="f-input" name="endDate">
                        </div>
                        <div>
                            <label class="f-label">IBAN</label>
                            <input type="text" class="f-input" name="iban" placeholder="IBAN de l'employ&eacute;">
                        </div>
                        <div>
                            <label class="f-label">ID Discord</label>
                            <input type="text" class="f-input" name="discordId" placeholder="ex. 123456789012345678">
                        </div>
                        <div>
                            <label class="f-label">ID Casier (salon Discord)</label>
                            <input type="text" class="f-input" name="casierId" placeholder="ex. 123456789012345678">
                        </div>
                        <div class="form-group-full">
                            <label class="f-label">Remplace (optionnel)</label>
                            <select class="f-select" name="replacesId" id="edit-replacesId">
                                <option value="">— Personne —</option>
                                <% replaceCandidates.forEach(function(c) { %>
                                    <option value="<%= c.id %>"><%= c.lastName %> <%= c.firstName %><%= c.status === 'inactive' ? ' (inactif)' : '' %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group-full">
                            <label style="display:inline-flex;align-items:center;gap:8px;cursor:pointer;">
                                <input type="checkbox" name="showInTeam" value="on">
                                <span style="font-size:13px;color:var(--text-secondary);">Afficher sur la page publique <strong>/equipe</strong></span>
                            </label>
                        </div>
                        <div class="form-group-full">
                            <label class="f-label">Notes</label>
                            <textarea class="f-textarea" name="notes" placeholder="Informations compl&eacute;mentaires sur l'employ&eacute;..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-secondary" onclick="closeModal('modal-edit')">Annuler</button>
                    <button type="submit" class="btn-primary"><i class="fa-solid fa-check"></i> Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Renouvellement contrat -->
    <div class="modal-overlay renew-modal" id="modal-renew">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-title" id="renew-title">Renouveler le contrat</div>
                <button class="modal-close" onclick="closeModal('modal-renew')">&#10005;</button>
            </div>
            <div class="modal-body">
                <div class="renew-grid">
                    <div class="renew-form-col">
                        <label>Nouvelle date de début</label>
                        <input type="date" class="f-input" id="renew-start">
                        <label>Nouvelle date de fin</label>
                        <input type="date" class="f-input" id="renew-end">
                        <div style="font-size:11.5px;color:var(--text-muted);padding:8px 10px;background:var(--bg);border:1px solid var(--border);">
                            En confirmant, l'ancien contrat passe en <code>superseded</code> et un nouveau contrat est généré. Le lien de signature est posté automatiquement dans le casier Discord de l'employé.
                        </div>
                    </div>
                    <div class="renew-preview-col">
                        <h4>Aperçu du nouveau contrat</h4>
                        <div class="renew-preview" id="renew-preview">
                            <div style="color:#777;text-align:center;padding:30px;">Chargement…</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeModal('modal-renew')">Annuler</button>
                <button type="button" class="btn-primary" id="btn-renew-confirm"><i class="fa-solid fa-check"></i> Confirmer le renouvellement</button>
            </div>
        </div>
    </div>

    <!-- Modal Récap -->
    <div class="modal-overlay" id="modal-recap">
        <div class="modal" style="width:1100px;">
            <div class="modal-header">
                <div class="modal-title" id="recap-title">Récap salarié</div>
                <button class="modal-close" onclick="closeModal('modal-recap')">&#10005;</button>
            </div>
            <div class="modal-body" id="recap-body">
                <div class="detail-empty"><div class="detail-empty-inner"><i class="fa-solid fa-spinner fa-spin"></i>Chargement…</div></div>
            </div>
        </div>
    </div>

    <style>
        .toolbar-select { width:auto; min-width:180px; padding:9px 34px 9px 13px; cursor:pointer; }
        .toolbar-reset-link {
            font-size:13px; color:var(--text-muted); text-decoration:none;
            display:inline-flex; align-items:center; gap:6px; padding:0 6px;
        }
        .toolbar-reset-link:hover { color:var(--text-primary); }
        .employee-name-link { color:var(--text-primary); text-decoration:none; cursor:pointer; transition:color .15s; }
        .employee-name-link:hover { color:var(--accent); text-decoration:underline; }
        .recap-section-title { font-family:var(--font-display); font-size:13px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:var(--text-secondary); margin:0 0 14px; }
        .recap-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:24px; }
        .recap-card { background:var(--bg-card); border:1px solid var(--border); padding:14px 16px; }
        .recap-card-label { font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--text-muted); margin-bottom:6px; }
        .recap-card-value { font-family:var(--font-mono); font-size:18px; font-weight:600; }
        .recap-card-sub { font-size:11px; color:var(--text-muted); margin-top:4px; }
        .recap-history-grid { display:grid; grid-template-columns:240px 1fr; gap:18px; }
        .recap-history-list { display:flex; flex-direction:column; gap:5px; max-height:360px; overflow-y:auto; }
        .recap-hi {
            display:flex; align-items:center; justify-content:space-between;
            padding:11px 14px; background:var(--bg-card); border:1px solid var(--border);
            cursor:pointer; transition:border-color .15s, background .15s;
        }
        .recap-hi:hover { border-color:rgba(255,255,255,.1); }
        .recap-hi.active { border-color:var(--accent); background:var(--accent-dim); }
        .recap-hi-week { font-family:var(--font-display); font-size:13px; font-weight:700; }
        .recap-hi-info { font-size:11px; color:var(--text-muted); margin-top:2px; }
        .recap-hi-rank { font-family:var(--font-mono); font-size:13px; font-weight:600; }
        .recap-empty { padding:18px; color:var(--text-muted); text-align:center; font-size:13px; }

        /* ── Bande "places à remplacer" ─────────────────────────────── */
        .absence-strip { margin-bottom:28px; }
        .absence-strip-header {
            display:flex; align-items:center; justify-content:space-between;
            margin-bottom:12px; gap:14px; flex-wrap:wrap;
        }
        .absence-strip-title {
            font-family:var(--font-display); font-size:13px; font-weight:700;
            letter-spacing:.16em; text-transform:uppercase; color:var(--text-secondary);
            display:inline-flex; align-items:center; gap:10px;
        }
        .absence-strip-count {
            background:var(--accent); color:#fff; font-size:11px; padding:2px 8px;
            border-radius:10px; letter-spacing:0;
        }
        .absence-strip-empty {
            padding:14px; background:var(--bg-card); border:1px dashed var(--border);
            color:var(--text-muted); font-size:13px; text-align:center;
        }
        .absence-cards {
            display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
            gap:12px;
        }
        .abs-card {
            background:var(--bg-card); border:1px solid var(--border);
            padding:14px; position:relative; display:flex; flex-direction:column;
            gap:6px; transition:border-color .15s, background .15s;
        }
        .abs-card-badge {
            font-family:var(--font-display); font-size:10px; font-weight:700;
            letter-spacing:.14em; text-transform:uppercase; padding:3px 8px;
            align-self:flex-start; border:1px solid currentColor;
        }
        .abs-card-name { font-weight:600; font-size:14px; }
        .abs-card-type { font-size:12px; color:var(--text-secondary); }
        .abs-card-dates { font-family:var(--font-mono); font-size:12px; color:var(--text-muted); margin-bottom:6px; }
        .abs-card-btn {
            display:inline-flex; align-items:center; justify-content:center; gap:6px;
            padding:8px 12px; font-size:12px; font-weight:600; cursor:pointer;
            border:1px solid currentColor; background:transparent; color:inherit;
            transition:background .15s;
        }
        .abs-ongoing     .abs-card-btn:hover { background:rgba(255,138,61,.18); }
        .abs-upcoming    .abs-card-btn:hover { background:rgba(59,130,246,.18); }
        .abs-ending-soon .abs-card-btn:hover { background:rgba(255,176,32,.18); }
        .abs-card-note { font-size:11px; color:var(--text-muted); font-style:italic; margin-top:4px; }

        .abs-ongoing { color:#ff8a3d; }
        .abs-ongoing:hover { border-color:#ff8a3d; }
        .abs-upcoming { color:#3B82F6; }
        .abs-upcoming:hover { border-color:#3B82F6; }
        .abs-ending-soon { color:#ffb020; }
        .abs-ending-soon:hover { border-color:#ffb020; }

        .abs-card-name, .abs-card-type, .abs-card-dates { color:var(--text-primary); }
        .abs-ongoing .abs-card-type, .abs-upcoming .abs-card-type, .abs-ending-soon .abs-card-type { color:var(--text-secondary); }
        .abs-ongoing .abs-card-dates, .abs-upcoming .abs-card-dates, .abs-ending-soon .abs-card-dates { color:var(--text-muted); }

        /* Toggle "Désactivation auto" — slider compact */
        .absence-toggle {
            display:inline-flex; align-items:center; gap:10px; cursor:pointer;
            font-size:12px; color:var(--text-secondary); user-select:none;
        }
        .absence-toggle input { display:none; }
        .absence-toggle-slider {
            width:36px; height:20px; background:var(--bg-card); border:1px solid var(--border);
            border-radius:10px; position:relative; transition:background .15s, border-color .15s;
        }
        .absence-toggle-slider::after {
            content:''; position:absolute; left:2px; top:2px; width:14px; height:14px;
            background:var(--text-muted); border-radius:50%; transition:left .15s, background .15s;
        }
        .absence-toggle input:checked + .absence-toggle-slider {
            background:var(--accent-dim); border-color:var(--accent);
        }
        .absence-toggle input:checked + .absence-toggle-slider::after {
            left:18px; background:var(--accent);
        }

        /* Pastille de statut contrat à côté du nom (à la manière de la duty-dot) */
        .contract-dot {
            display:inline-block; width:8px; height:8px; border-radius:50%;
            margin-right:6px; vertical-align:middle;
        }
        .contract-dot.none    { background:#555; }
        .contract-dot.pending { background:#3B82F6; box-shadow:0 0 0 2px rgba(59,130,246,.2); }
        .contract-dot.partial { background:#f59e0b; box-shadow:0 0 0 2px rgba(245,158,11,.2); }
        .contract-dot.signed  { background:#22c55e; box-shadow:0 0 0 2px rgba(34,197,94,.2); }

        /* Bouton "Renouveler le contrat" coloré selon urgence */
        .btn-renew {
            display:inline-flex; align-items:center; justify-content:center;
            width:30px; height:30px; cursor:pointer; border-radius:3px;
            border:1px solid currentColor; background:transparent;
        }
        .btn-renew-green  { color:#22c55e; }
        .btn-renew-orange { color:#f59e0b; }
        .btn-renew-red    { color:#ef4444; animation:pulseRenew 1.6s ease-in-out infinite; }
        .btn-renew-none   { color:var(--text-muted); }
        .btn-renew-green:hover  { background:rgba(34,197,94,.18); }
        .btn-renew-orange:hover { background:rgba(245,158,11,.18); }
        .btn-renew-red:hover    { background:rgba(239,68,68,.18); }
        .btn-renew-none:hover   { background:rgba(255,255,255,.06); border-color:var(--text-secondary); color:var(--text-secondary); }
        @keyframes pulseRenew {
            0%,100% { box-shadow:0 0 0 0 rgba(239,68,68,.35); }
            50%     { box-shadow:0 0 0 4px rgba(239,68,68,0); }
        }

        /* Modal renouvellement : aperçu + dates */
        .renew-modal .modal { width:880px; }
        .renew-grid { display:grid; grid-template-columns:280px 1fr; gap:18px; }
        .renew-form-col label { display:block; font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:var(--text-secondary); margin-bottom:6px; }
        .renew-form-col input { width:100%; padding:9px 12px; margin-bottom:14px; }
        .renew-preview-col h4 { margin:0 0 8px; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--text-secondary); }
        .renew-preview {
            background:#fff; color:#111; padding:20px 24px;
            border:1px solid var(--border); font-family:Georgia, serif;
            font-size:12.5px; line-height:1.55;
            max-height:420px; overflow:auto;
        }

        /* Badge "Remplace [Nom]" dans la liste salariés */
        .replaces-badge {
            display:inline-flex; align-items:center; gap:4px;
            font-size:10.5px; padding:2px 7px; margin-left:6px;
            background:var(--accent-dim); color:var(--accent);
            border:1px solid var(--accent); border-radius:3px;
            font-weight:600; letter-spacing:.04em;
        }
    </style>

    <%# Cache complet pour les modals : doit pouvoir éditer un employé même hors page courante. %>
    <script type="application/json" id="employees-data"><%- JSON.stringify(allEmployees).replace(/</g, '\\u003c') %></script>

    <div class="toast success" id="toast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="toast-msg">Action effectu&eacute;e</span>
    </div>

    <script src="/js/admin-ajax.js"></script>
    <script>
        var employeesData = JSON.parse(document.getElementById('employees-data').textContent);

        // Re-parse le cache JSON après un soft-reload (toggle/edit/delete).
        // Le filtre + tri + pagination sont gérés côté serveur, donc rien
        // d'autre à faire ici.
        window.addEventListener('admin:reloaded', function() {
            var el = document.getElementById('employees-data');
            if (el) employeesData = JSON.parse(el.textContent);
        });

        // Interception des submits add/edit en AJAX
        function hookForm(selector, modalId, successMsg) {
            var form = document.querySelector(selector);
            if (!form) return;
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                AdminAjax.postForm(form).then(function(data) {
                    closeModal(modalId);
                    if (modalId === 'modal-add') form.reset();
                    showToast(successMsg);
                    if (data && data.casierWarning) {
                        setTimeout(function() {
                            showToast('Casier Discord non créé : ' + data.casierWarning, 'error');
                        }, 1500);
                    }
                    return AdminAjax.reloadMain();
                }).catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
            });
        }
        hookForm('#modal-add form', 'modal-add', 'Salarié ajouté');
        hookForm('#form-edit', 'modal-edit', 'Salarié modifié');

        function toDateInput(value) {
            if (!value) return '';
            // Date object → composer YYYY-MM-DD en local (toISOString() décalerait
            // d'un jour pour les dates de minuit côté Europe/Paris).
            if (value instanceof Date) {
                var y = value.getFullYear();
                var m = String(value.getMonth() + 1).padStart(2, '0');
                var d = String(value.getDate()).padStart(2, '0');
                return y + '-' + m + '-' + d;
            }
            return String(value).split('T')[0];
        }

        function editEmployee(id) {
            var emp = employeesData.find(function(e) { return e.id === id; });
            if (!emp) { showToast('Employé introuvable', 'error'); return; }
            var form = document.getElementById('form-edit');
            form.action = '/admin/salaries/' + id + '/edit';
            form.firstName.value = emp.firstName || '';
            form.lastName.value  = emp.lastName  || '';
            form.contract.value  = emp.contract  || 'CDD';
            form.role.value      = emp.role      || '';
            form.phone.value     = emp.phone     || '';
            form.hireDate.value  = toDateInput(emp.hireDate);
            form.endDate.value   = toDateInput(emp.endDate);
            form.iban.value      = emp.iban      || '';
            form.discordId.value = emp.discordId || '';
            form.casierId.value  = emp.casierId  || emp.channelId || '';
            // Cache l'option auto-référence (un employé ne se remplace pas lui-même)
            Array.from(form.replacesId.options).forEach(function(opt) {
                opt.hidden = (opt.value && String(opt.value) === String(id));
            });
            form.replacesId.value = emp.replacesId != null ? String(emp.replacesId) : '';
            form.showInTeam.checked = emp.showInTeam !== false;
            form.notes.value     = emp.notes     || '';
            openModal('modal-edit');
        }

        // Ouvre la modal "Ajouter un salarié" pré-remplie à partir d'une carte d'absence.
        // Règle dates : hireDate = max(today, absence.start) (cohérence "on n'embauche
        // pas dans le passé"), endDate = absence.end. Contrat forcé CDD.
        function openReplaceModalFromCard(btn) {
            var card = btn.closest('.abs-card');
            if (!card) return;
            var employeeId = card.dataset.employeeId;
            var employeeName = card.dataset.employeeName || '';
            var dateStart = card.dataset.dateStart ? new Date(card.dataset.dateStart) : null;
            var dateEnd = card.dataset.dateEnd ? new Date(card.dataset.dateEnd) : null;
            var today = new Date(); today.setHours(0,0,0,0);
            var effectiveStart = (dateStart && dateStart > today) ? dateStart : today;

            var form = document.querySelector('#modal-add form');
            if (!form) return;
            form.reset();
            form.contract.value = 'CDD';
            form.hireDate.value = toDateInput(effectiveStart);
            form.endDate.value = dateEnd ? toDateInput(dateEnd) : '';
            if (form.replacesId && employeeId) form.replacesId.value = String(employeeId);

            // Petit bandeau d'info en haut de la modal pour rappeler qui on remplace.
            var header = document.querySelector('#modal-add .modal-header .modal-title');
            if (header && employeeName) {
                header.innerHTML = 'Ajouter un salari&eacute; <span style="font-size:12px;color:var(--text-muted);font-weight:400;margin-left:8px;">remplace ' + employeeName + '</span>';
            }
            openModal('modal-add');
        }

        // Toggle du flag global "désactivation auto à l'absence"
        var autoDeactivateToggle = document.getElementById('toggle-auto-deactivate');
        if (autoDeactivateToggle) {
            autoDeactivateToggle.addEventListener('change', function() {
                var enabled = autoDeactivateToggle.checked;
                fetch('/admin/salaries/config/auto-deactivate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ enabled: enabled }),
                })
                .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function() { showToast(enabled ? 'Désactivation auto activée' : 'Désactivation auto désactivée'); })
                .catch(function(err) {
                    autoDeactivateToggle.checked = !enabled; // rollback visuel
                    showToast('Erreur : ' + err.message, 'error');
                });
            });
        }

        // Réactivation rapide depuis une carte "fin dans 3j" (compte resté inactif).
        function reactivateFromCard(btn) {
            var card = btn.closest('.abs-card');
            if (!card) return;
            var employeeId = card.dataset.employeeId;
            if (!employeeId) return;
            if (!confirm('Réactiver ' + (card.dataset.employeeName || 'cet employé') + ' ?')) return;
            AdminAjax.post('/admin/salaries/' + employeeId + '/toggle')
                .then(function() { showToast('Compte réactivé'); return AdminAjax.reloadMain(); })
                .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        }

        // Reset du titre de la modal add quand on la ferme par les boutons standards
        // (sinon le "remplace X" reste affiché à la prochaine ouverture vierge).
        (function() {
            var defaultTitle = 'Ajouter un salari&eacute;';
            ['modal-add'].forEach(function(id) {
                var overlay = document.getElementById(id);
                if (!overlay) return;
                var observer = new MutationObserver(function() {
                    if (!overlay.classList.contains('open')) {
                        var h = overlay.querySelector('.modal-title');
                        if (h) h.innerHTML = defaultTitle;
                    }
                });
                observer.observe(overlay, { attributes: true, attributeFilter: ['class'] });
            });
        })();

        // ── Renouvellement de contrat (bouton coloré sur chaque ligne) ──────
        var renewState = { employeeId: null, debounceTimer: null };

        function pad(n) { return String(n).padStart(2, '0'); }
        function isoDate(d) {
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        }

        function openRenewModal(employeeId) {
            var emp = employeesData.find(function(e) { return e.id === employeeId; });
            if (!emp) { showToast('Employé introuvable', 'error'); return; }
            renewState.employeeId = employeeId;
            document.getElementById('renew-title').innerHTML =
                'Renouveler le contrat <span style="font-size:12px;color:var(--text-muted);font-weight:400;margin-left:8px;">' + emp.firstName + ' ' + emp.lastName + '</span>';
            var today = new Date();
            var defaultEnd = new Date(today.getTime() + 21 * 86400000);
            document.getElementById('renew-start').value = isoDate(today);
            document.getElementById('renew-end').value = isoDate(defaultEnd);
            document.getElementById('renew-preview').innerHTML =
                '<div style="color:#777;text-align:center;padding:30px;">Chargement…</div>';
            openModal('modal-renew');
            refreshRenewPreview();
        }

        function refreshRenewPreview() {
            if (!renewState.employeeId) return;
            fetch('/admin/contracts/preview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    employeeId: renewState.employeeId,
                    startDate: document.getElementById('renew-start').value,
                    endDate: document.getElementById('renew-end').value,
                }),
            })
            .then(function(r) { return r.json().then(function(d) { return { ok:r.ok, data:d }; }); })
            .then(function(r) {
                if (!r.ok) throw new Error((r.data && r.data.error) || 'Erreur');
                document.getElementById('renew-preview').innerHTML = r.data.html;
            })
            .catch(function(err) {
                document.getElementById('renew-preview').innerHTML =
                    '<div style="color:#ef4444;padding:20px;">Erreur : ' + err.message + '</div>';
            });
        }

        // Rafraîchit l'aperçu quand l'admin change les dates (avec debounce léger)
        ['renew-start', 'renew-end'].forEach(function(id) {
            var el = document.getElementById(id);
            el.addEventListener('change', function() {
                clearTimeout(renewState.debounceTimer);
                renewState.debounceTimer = setTimeout(refreshRenewPreview, 200);
            });
        });

        document.getElementById('btn-renew-confirm').addEventListener('click', function() {
            if (!renewState.employeeId) return;
            var btn = this;
            btn.disabled = true;
            fetch('/admin/contracts/renew/' + renewState.employeeId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    startDate: document.getElementById('renew-start').value,
                    endDate: document.getElementById('renew-end').value,
                }),
            })
            .then(function(r) { return r.json().then(function(d) { return { ok:r.ok, data:d }; }); })
            .then(function(r) {
                if (!r.ok) throw new Error((r.data && r.data.error) || 'Erreur');
                showToast('Contrat renouvelé, lien envoyé sur Discord');
                closeModal('modal-renew');
                return AdminAjax.reloadMain();
            })
            .catch(function(err) {
                showToast('Erreur : ' + err.message, 'error');
                btn.disabled = false;
            })
            .then(function() { btn.disabled = false; });
        });

        // Génération manuelle d'un contrat pour un employé pré-existant sans contrat.
        function generateContract(employeeId) {
            var emp = employeesData.find(function(e) { return e.id === employeeId; });
            var name = emp ? (emp.firstName + ' ' + emp.lastName) : 'cet employé';
            if (!confirm('Générer un contrat pour ' + name + ' et envoyer le lien sur Discord ?')) return;
            fetch('/admin/contracts/generate/' + employeeId, {
                method: 'POST',
                credentials: 'same-origin',
            })
            .then(function(r) { return r.json().then(function(d) { return { ok:r.ok, data:d }; }); })
            .then(function(r) {
                if (!r.ok) throw new Error((r.data && r.data.error) || 'Erreur');
                showToast('Contrat généré');
                return AdminAjax.reloadMain();
            })
            .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        }

        function toggleStatus(id) {
            AdminAjax.post('/admin/salaries/' + id + '/toggle')
                .then(function() { return AdminAjax.reloadMain(); })
                .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        }

        function toggleAdmin(id) {
            AdminAjax.post('/admin/salaries/' + id + '/toggle-admin')
                .then(function() { return AdminAjax.reloadMain(); })
                .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        }

        function deleteEmployee(id) {
            if (!confirm('Supprimer définitivement cet employé ?')) return;
            AdminAjax.post('/admin/salaries/' + id + '/delete')
                .then(function(data) {
                    if (data && data.botWarning) {
                        setTimeout(function() {
                            showToast('Casier Discord non archivé : ' + data.botWarning, 'error');
                        }, 1500);
                    }
                    return AdminAjax.reloadMain();
                })
                .catch(function(err) { showToast('Erreur : ' + err.message, 'error'); });
        }

        var recapState = { history: [], selectedKey: null };
        var fmtMoney = function(n) { return new Intl.NumberFormat('fr-FR').format(Math.round(n || 0)) + '$'; };

        function openRecap(id) {
            openModal('modal-recap');
            var emp = employeesData.find(function(e) { return e.id === id; });
            document.getElementById('recap-title').textContent = emp
                ? 'Récap — ' + emp.firstName + ' ' + emp.lastName
                : 'Récap salarié';
            document.getElementById('recap-body').innerHTML =
                '<div class="detail-empty"><div class="detail-empty-inner"><i class="fa-solid fa-spinner fa-spin"></i>Chargement…</div></div>';

            fetch('/admin/salaries/' + id + '/recap', { credentials: 'same-origin' })
                .then(function(r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                .then(function(data) { renderRecap(data); })
                .catch(function(err) {
                    document.getElementById('recap-body').innerHTML =
                        '<div class="recap-empty">Erreur de chargement : ' + err.message + '</div>';
                });
        }

        function renderRecap(data) {
            recapState.history = data.history || [];
            recapState.selectedKey = null;

            var c = data.current || {};
            var currentHtml;
            if (c.empty) {
                currentHtml =
                    '<div class="recap-empty">Aucune activité enregistrée pour cette semaine.</div>';
            } else {
                var primes = (c.bonusSalary || 0) + (c.tierPrime || 0) + (c.podiumPrize || 0) + (c.specialBonus || 0);
                // Frais NET : remboursements reçus moins pénalité fourrière (perte employé).
                var frais = (c.expenseRefund || 0) + (c.repatBonus || 0) + (c.impoundReimbursement || 0) - (c.impoundPenalty || 0);
                var finaleColor = (c.primeFinale || 0) >= 0 ? 'c-success' : 'c-danger';
                var finaleSign = (c.primeFinale || 0) >= 0 ? '+' : '-';
                currentHtml =
                    '<div class="recap-grid">' +
                        '<div class="recap-card"><div class="recap-card-label">Rang</div><div class="recap-card-value">#' + (c.rank || '—') + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Livraisons</div><div class="recap-card-value c-accent">' + (c.deliveries || 0) + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Gain entreprise</div><div class="recap-card-value c-gold">' + fmtMoney(c.gainEnterprise) + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Gain employé</div><div class="recap-card-value">' + fmtMoney(c.gainEmployee) + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Prime de livraisons</div><div class="recap-card-value">' + fmtMoney(c.bonusSalary) + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Prime palier</div><div class="recap-card-value">' + fmtMoney(c.tierPrime) + '<div class="recap-card-sub">Palier ' + (c.tierLevel || 0) + '</div></div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Prime podium</div><div class="recap-card-value c-gold">' + fmtMoney(c.podiumPrize) + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Prime spéciale</div><div class="recap-card-value c-accent">' + fmtMoney(c.specialBonus) +
                            (c.specialBonusReason ? '<div class="recap-card-sub">' + escapeHtml(c.specialBonusReason) + '</div>' : '') + '</div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Notes de frais</div><div class="recap-card-value">' + fmtMoney(c.expenseRefund) + '<div class="recap-card-sub">sur ' + fmtMoney(c.expenseCost) + ' déclarés</div></div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Rapatriements</div><div class="recap-card-value">' + fmtMoney(c.repatBonus) + '<div class="recap-card-sub">' + (c.repatCount || 0) + ' évt.</div></div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Fourrières</div><div class="recap-card-value c-danger">-' + fmtMoney(c.impoundPenalty) + '<div class="recap-card-sub">' + (c.impoundCount || 0) + ' évt.</div></div></div>' +
                        '<div class="recap-card"><div class="recap-card-label">Prime finale</div><div class="recap-card-value ' + finaleColor + '">' + finaleSign + fmtMoney(Math.abs(c.primeFinale || 0)) + '</div></div>' +
                    '</div>';
            }

            var historyListHtml;
            if (recapState.history.length === 0) {
                historyListHtml = '<div class="recap-empty">Aucun historique figé.</div>';
            } else {
                historyListHtml = '<div class="recap-history-list">' + recapState.history.map(function(h, i) {
                    var rankColor = h.rank >= 1 && h.rank <= 3 ? 'var(--gold)' : 'var(--text-secondary)';
                    return '<div class="recap-hi" id="recap-hi-' + i + '" onclick="selectRecapWeek(' + i + ')">' +
                        '<div><div class="recap-hi-week">S' + h.week + ' &middot; ' + h.year + '</div>' +
                        '<div class="recap-hi-info">' + h.deliveries + ' livr. &middot; Palier ' + h.tierLevel + '</div></div>' +
                        '<div class="recap-hi-rank" style="color:' + rankColor + '">' + (h.rank ? '#' + h.rank : '—') + '</div>' +
                    '</div>';
                }).join('') + '</div>';
            }

            document.getElementById('recap-body').innerHTML =
                '<div class="recap-section-title">Semaine en cours — S' + (c.week || '?') + '</div>' +
                currentHtml +
                '<div class="recap-section-title">Historique</div>' +
                '<div class="recap-history-grid">' +
                    '<div>' + historyListHtml + '</div>' +
                    '<div id="recap-detail">' +
                        '<div class="detail-empty"><div class="detail-empty-inner"><i class="fa-solid fa-clock-rotate-left"></i>Sélectionnez une semaine pour afficher le détail</div></div>' +
                    '</div>' +
                '</div>';
        }

        function selectRecapWeek(i) {
            var h = recapState.history[i];
            if (!h) return;
            recapState.selectedKey = i;
            document.querySelectorAll('.recap-hi').forEach(function(el) { el.classList.remove('active'); });
            var node = document.getElementById('recap-hi-' + i);
            if (node) node.classList.add('active');

            var primes = (h.bonusSalary || 0) + (h.tierPrime || 0) + (h.podiumPrize || 0) + (h.specialBonus || 0);
            var frais = (h.expenseRefund || 0) + (h.repatBonus || 0) + (h.impoundReimbursement || 0) - (h.impoundPenalty || 0);
            var finaleColor = (h.primeFinale || 0) >= 0 ? 'c-success' : 'c-danger';
            var finaleSign = (h.primeFinale || 0) >= 0 ? '+' : '-';
            document.getElementById('recap-detail').innerHTML =
                '<div class="recap-grid" style="grid-template-columns:repeat(3,1fr);">' +
                    '<div class="recap-card"><div class="recap-card-label">Livraisons</div><div class="recap-card-value c-accent">' + (h.deliveries || 0) + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Gain entreprise</div><div class="recap-card-value c-gold">' + fmtMoney(h.gainEnterprise) + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Gain employé</div><div class="recap-card-value">' + fmtMoney(h.gainEmployee) + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Prime de livraisons</div><div class="recap-card-value">' + fmtMoney(h.bonusSalary) + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Prime palier</div><div class="recap-card-value">' + fmtMoney(h.tierPrime) + '<div class="recap-card-sub">Palier ' + (h.tierLevel || 0) + '</div></div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Prime podium</div><div class="recap-card-value c-gold">' + fmtMoney(h.podiumPrize) + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Prime spéciale</div><div class="recap-card-value c-accent">' + fmtMoney(h.specialBonus) +
                        (h.specialBonusReason ? '<div class="recap-card-sub">' + escapeHtml(h.specialBonusReason) + '</div>' : '') + '</div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Notes de frais</div><div class="recap-card-value">' + fmtMoney(h.expenseRefund) + '<div class="recap-card-sub">sur ' + fmtMoney(h.expenseCost) + ' déclarés</div></div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Rapatriements</div><div class="recap-card-value">' + fmtMoney(h.repatBonus) + '<div class="recap-card-sub">' + (h.repatCount || 0) + ' évt.</div></div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Fourrières</div><div class="recap-card-value c-danger">-' + fmtMoney(h.impoundPenalty) + '<div class="recap-card-sub">' + (h.impoundCount || 0) + ' évt.</div></div></div>' +
                    '<div class="recap-card"><div class="recap-card-label">Prime finale</div><div class="recap-card-value ' + finaleColor + '">' + finaleSign + fmtMoney(Math.abs(h.primeFinale || 0)) + '</div></div>' +
                '</div>';
        }

        function escapeHtml(s) {
            return String(s == null ? '' : s)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function openModal(id) {
            var overlay = document.getElementById(id);
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            var overlay = document.getElementById(id);
            overlay.classList.remove('open');
            document.body.style.overflow = '';
        }

        function showToast(msg, type) {
            type = type || 'success';
            var t = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            t.className = 'toast ' + type + ' show';
            setTimeout(function() { t.classList.remove('show'); }, 3500);
        }

        // Outside-click-to-close modals
        document.querySelectorAll('.modal-overlay').forEach(function(overlay) {
            var downTarget = null;
            overlay.addEventListener('mousedown', function(e) { downTarget = e.target; });
            overlay.addEventListener('mouseup', function(e) {
                if (downTarget === overlay && e.target === overlay) {
                    overlay.classList.remove('open');
                    document.body.style.overflow = '';
                }
                downTarget = null;
            });
        });
    </script>
    <script src="/js/search-autosubmit.js"></script>
    <script src="/js/auto-refresh.js"></script>
</body>
</html>
