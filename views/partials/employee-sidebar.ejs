<aside class="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-brand">RON <span>OIL</span></div>
        <div class="sidebar-brand-sub">Espace Employ&eacute;</div>
    </div>
    <div class="sidebar-week">
        <div class="sidebar-week-label">Semaine</div>
        <div class="sidebar-week-num"><%= currentWeek %></div>
    </div>
    <% if (typeof pendingContract !== 'undefined' && pendingContract) { %>
        <a class="contract-pending-banner" href="/contract/<%= pendingContract.signToken %>">
            <i class="fa-solid fa-file-signature"></i>
            <span>Contrat à signer</span>
        </a>
        <style>
            .contract-pending-banner {
                display:flex; align-items:center; gap:10px;
                margin:10px 14px 14px; padding:10px 12px;
                background:rgba(245,158,11,.12); border:1px solid #f59e0b;
                color:#fbbf24; text-decoration:none; font-size:12px; font-weight:600;
                animation:pulseGlow 2.4s ease-in-out infinite;
            }
            .contract-pending-banner:hover { background:rgba(245,158,11,.22); }
            @keyframes pulseGlow {
                0%,100% { box-shadow:0 0 0 0 rgba(245,158,11,.4); }
                50%     { box-shadow:0 0 0 4px rgba(245,158,11,0); }
            }
        </style>
    <% } %>
    <nav class="sidebar-nav">
        <div class="nav-section" data-section="emp-navigation">
            <button type="button" class="nav-section-label">Navigation <i class="fa-solid fa-chevron-down nav-chevron"></i></button>
            <div class="nav-section-items">
                <a class="nav-item<%= currentPage === 'dashboard' ? ' active' : '' %>" id="nav-dashboard" href="/dashboard">
                    <i class="fa-solid fa-gauge-high"></i> Dashboard
                </a>
                <a class="nav-item<%= currentPage === 'profil' ? ' active' : '' %>" id="nav-profil" href="/profil">
                    <i class="fa-solid fa-user"></i> Mon Profil
                </a>
                <a class="nav-item<%= currentPage === 'classement' ? ' active' : '' %>" id="nav-classement" href="/classement">
                    <i class="fa-solid fa-trophy"></i> Classement
                </a>
                <a class="nav-item<%= currentPage === 'faq' ? ' active' : '' %>" id="nav-faq" href="/faq">
                    <i class="fa-solid fa-circle-question"></i> FAQ
                </a>
            </div>
        </div>
        <div class="nav-section" data-section="emp-formulaires">
            <button type="button" class="nav-section-label">Formulaires <i class="fa-solid fa-chevron-down nav-chevron"></i></button>
            <div class="nav-section-items">
                <a class="nav-item<%= currentPage === 'absences' ? ' active' : '' %>" id="nav-absences" href="/absences">
                    <i class="fa-solid fa-calendar-xmark"></i> Absences
                </a>
                <a class="nav-item<%= currentPage === 'frais' ? ' active' : '' %>" id="nav-frais" href="/frais">
                    <i class="fa-solid fa-receipt"></i> Notes de frais
                </a>
                <a class="nav-item<%= currentPage === 'pannes' ? ' active' : '' %>" id="nav-pannes" href="/pannes">
                    <i class="fa-solid fa-triangle-exclamation"></i> Pannes
                </a>
                <% if (canRapatriement(employee.role)) { %>
                <a class="nav-item<%= currentPage === 'rapatriements' ? ' active' : '' %>" id="nav-rapatriements" href="/rapatriements">
                    <i class="fa-solid fa-truck-arrow-right"></i> Rapatriements
                </a>
                <% } %>
            </div>
        </div>

        <% if (session && session.isAdmin) { %>
            <div class="nav-section" data-section="emp-administration">
                <button type="button" class="nav-section-label">Administration <i class="fa-solid fa-chevron-down nav-chevron"></i></button>
                <div class="nav-section-items">
                    <a class="nav-item" href="/admin/salaries">
                        <i class="fa-solid fa-shield-halved"></i> Panel Admin
                    </a>
                </div>
            </div>
        <% } %>
    </nav>
    <div class="sidebar-user">
        <div class="user-avatar"><%= employee.firstName.charAt(0) %><%= employee.lastName.charAt(0) %></div>
        <div>
            <div class="user-name"><%= employee.firstName %> <%= employee.lastName %></div>
            <div class="user-role"><%= employee.role %> &middot; <%= employee.contract %></div>
        </div>
        <a class="btn-logout" href="/logout" title="D&eacute;connexion">
            <i class="fa-solid fa-right-from-bracket"></i>
        </a>
    </div>
</aside>
<script src="/js/sidebar-collapse.js"></script>
