<%# Header partagé des 6 pages du groupe Configuration.
   À inclure en haut du <main> de chaque sous-page, avec activeKey égal à
   la clé de la page courante (cf. tabs[].key ci-dessous). %>
<%- include('group-tabs', {
    groupTitle: 'Configuration',
    groupSubtitle: 'Référentiels et paramètres : primes, rôles, types, contrats, FAQ, gouvernement',
    activeKey: typeof activeKey !== 'undefined' ? activeKey : '',
    tabs: [
        { key: 'primes',    label: 'Primes',       href: '/admin/primes',    icon: 'fa-percent' },
        { key: 'roles',     label: 'Rôles',        href: '/admin/roles',     icon: 'fa-id-badge' },
        { key: 'types',     label: 'Types',        href: '/admin/types',     icon: 'fa-tags' },
        { key: 'contracts', label: 'Contrats',     href: '/admin/contracts', icon: 'fa-file-signature' },
        { key: 'faq',       label: 'FAQ',          href: '/admin/faq',       icon: 'fa-circle-question' },
        { key: 'gouv',      label: 'Gouvernement', href: '/admin/gouv',      icon: 'fa-landmark' },
    ]
}) %>
