<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('../partials/head') %>
    <title>RON OIL — Mon contrat</title>
    <link rel="stylesheet" href="/css/shared.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <style>
        .contract-page { max-width: 900px; margin: 0 auto; }
        .contract-status-bar {
            display:flex; align-items:center; justify-content:space-between;
            padding:14px 20px; margin-bottom:24px;
            background:var(--bg-card); border:1px solid var(--border);
            border-left:4px solid var(--accent);
            font-size:13px;
        }
        .contract-status-bar.signed   { border-left-color:#22c55e; }
        .contract-status-bar.partial  { border-left-color:#f59e0b; }
        .contract-status-bar.pending  { border-left-color:#3B82F6; }
        .contract-status-bar.cancelled,
        .contract-status-bar.superseded { border-left-color:#ef4444; opacity:.7; }
        .contract-status-bar strong { letter-spacing:.04em; }

        .contract-paper {
            background:#fff; color:#111; padding:48px 56px;
            border:1px solid var(--border);
            box-shadow:0 4px 24px rgba(0,0,0,.4);
            font-family:Georgia, 'Times New Roman', serif;
            font-size:14px; line-height:1.7;
            margin-bottom:24px;
            max-height:70vh; overflow-y:auto;
        }
        .contract-paper h1, .contract-paper h2, .contract-paper h3 {
            font-family:Georgia, serif; color:#000; line-height:1.3;
        }
        .contract-paper p, .contract-paper li { color:#222; }
        .contract-paper strong { color:#000; }
        /* Le reset global * {margin:0;padding:0} de shared.css écrase le défaut
           navigateur → on restaure listes + paragraphes côté contrat. */
        .contract-paper p { margin:0 0 .9em; }
        .contract-paper p:last-child { margin-bottom:0; }
        .contract-paper ul, .contract-paper ol { padding-left:1.6em; margin:0 0 .9em; }
        .contract-paper ul { list-style:disc; }
        .contract-paper ol { list-style:decimal; }
        .contract-paper li { margin-bottom:.25em; }
        /* Classes générées par Quill : alignement + indentation. Quill.snow.css
           n'est pas chargée ici (page publique), donc on duplique localement. */
        .contract-paper .ql-align-center  { text-align:center; }
        .contract-paper .ql-align-right   { text-align:right; }
        .contract-paper .ql-align-justify { text-align:justify; }
        .contract-paper .ql-indent-1  { padding-left:3em; }
        .contract-paper .ql-indent-2  { padding-left:6em; }
        .contract-paper .ql-indent-3  { padding-left:9em; }
        .contract-paper .ql-indent-4  { padding-left:12em; }
        .contract-paper .ql-indent-5  { padding-left:15em; }
        .contract-paper .ql-indent-6  { padding-left:18em; }
        .contract-paper .ql-indent-7  { padding-left:21em; }
        .contract-paper .ql-indent-8  { padding-left:24em; }

        .sign-block {
            background:var(--bg-card); border:1px solid var(--border);
            padding:24px; margin-bottom:24px;
        }
        .sign-block h2 {
            font-family:var(--font-display); font-size:13px; letter-spacing:.16em;
            text-transform:uppercase; color:var(--text-secondary); margin:0 0 16px;
        }
        .sign-row {
            display:flex; align-items:center; gap:10px; margin-bottom:12px;
            font-size:13px;
        }
        .sign-row input[type=checkbox] { width:18px; height:18px; cursor:pointer; }
        .sign-row label { cursor:pointer; }
        .sign-name {
            display:block; width:100%; padding:11px 14px; font-size:14px;
            background:var(--bg-card-deeper, var(--bg)); color:var(--text-primary);
            border:1px solid var(--border); margin-bottom:6px;
        }
        .sign-name:focus { outline:none; border-color:var(--accent); }
        .sign-name.invalid { border-color:#ef4444; }
        .sign-name-err {
            display:none; font-size:12px; color:#f87171; margin-bottom:14px;
        }
        .sign-name-err.show { display:block; }
        .sign-actions { display:flex; gap:10px; justify-content:flex-end; }
        .btn-sign {
            display:inline-flex; align-items:center; gap:8px;
            padding:11px 22px; font-weight:600; font-size:13px;
            background:#22c55e; color:#fff; border:none; cursor:pointer;
            text-transform:uppercase; letter-spacing:.06em;
        }
        .btn-sign:disabled { background:#3a3a3a; cursor:not-allowed; }
        .btn-sign:not(:disabled):hover { background:#16a34a; }
        .btn-print {
            display:inline-flex; align-items:center; gap:8px;
            padding:9px 18px; font-size:12px; font-weight:600;
            background:transparent; color:var(--text-primary);
            border:1px solid var(--border); cursor:pointer;
        }
        .btn-print:hover { border-color:var(--accent); color:var(--accent); }

        .sig-already {
            display:grid; grid-template-columns:repeat(3,1fr); gap:14px;
            margin-top:14px;
        }
        .sig-card {
            padding:12px 14px; background:var(--bg-card-deeper, var(--bg));
            border:1px solid var(--border); font-size:12px;
        }
        .sig-card-label {
            font-size:10.5px; letter-spacing:.16em; text-transform:uppercase;
            color:var(--text-muted); margin-bottom:6px;
        }
        .sig-card-val { color:var(--text-primary); font-weight:600; }
        .sig-card-sub { color:var(--text-muted); font-size:11px; margin-top:2px; }
        .sig-card.pending .sig-card-val { color:var(--text-muted); font-weight:400; font-style:italic; }
        .sig-card.done { border-left:3px solid #22c55e; }

        @media (max-width: 767.98px) {
            .contract-paper { padding:24px 22px; font-size:13px; max-height:60vh; }
            .sig-already { grid-template-columns:1fr; gap:10px; }
            .sign-block { padding:18px; }
            .contract-status-bar { flex-wrap:wrap; gap:10px; padding:12px 16px; }
        }

        @media print {
            body * { visibility:hidden; }
            .contract-paper, .contract-paper * { visibility:visible; }
            .contract-paper { position:absolute; inset:0; box-shadow:none; border:none; }
        }
    </style>
</head>
<body>
    <%- include('../partials/employee-sidebar', { currentPage: 'contract', employee: employee, currentWeek: currentWeek }) %>

    <main class="main-content">
        <div class="page-header">
            <div class="page-title">Mon contrat</div>
            <div class="page-subtitle">
                <%= contract.contractKind %>
                <% if (contract.endDate) { %> &middot; jusqu'au <%= new Date(contract.endDate).toLocaleDateString('fr-FR') %><% } %>
            </div>
        </div>

        <div class="contract-page">
            <%
                let statusClass = 'pending';
                let statusLabel = 'En attente de votre signature';
                if (contract.status === 'employee-signed') { statusClass = 'partial'; statusLabel = 'Signé par vous &mdash; en attente de la direction'; }
                else if (contract.status === 'company-signed') { statusClass = 'partial'; statusLabel = 'Signé par vous + direction &mdash; en attente de l\'avocat'; }
                else if (contract.status === 'signed') { statusClass = 'signed'; statusLabel = 'Contrat finalisé'; }
                else if (contract.status === 'cancelled') { statusClass = 'cancelled'; statusLabel = 'Contrat annulé'; }
                else if (contract.status === 'superseded') { statusClass = 'superseded'; statusLabel = 'Remplacé par un nouveau contrat'; }
            %>
            <div class="contract-status-bar <%= statusClass %>">
                <div><strong><%- statusLabel %></strong></div>
                <% if (contract.status !== 'pending') { %>
                    <button class="btn-print" onclick="window.print()" title="Imprimer / exporter en PDF">
                        <i class="fa-solid fa-print"></i> Imprimer
                    </button>
                <% } %>
            </div>

            <div class="contract-paper">
                <%- contract.htmlSnapshot %>
            </div>

            <% if (contract.status === 'pending') { %>
                <div class="sign-block">
                    <h2><i class="fa-solid fa-pen-nib"></i> Signature</h2>
                    <form id="sign-form">
                        <label class="sign-row" for="sign-accepted">
                            <input type="checkbox" id="sign-accepted" name="accepted" value="on">
                            <span>J'ai lu et j'accepte les termes du présent contrat.</span>
                        </label>
                        <label class="f-label" for="sign-name">Tape ton nom complet pour signer</label>
                        <input type="text" id="sign-name" name="name" class="sign-name"
                               placeholder="<%= employee.firstName %> <%= employee.lastName %>"
                               data-expected="<%= employee.firstName %> <%= employee.lastName %>"
                               autocomplete="off" required>
                        <div class="sign-name-err" id="sign-name-err">Le nom saisi doit correspondre exactement à <strong><%= employee.firstName %> <%= employee.lastName %></strong>.</div>
                        <div class="sign-actions">
                            <button type="submit" class="btn-sign" id="btn-sign" disabled>
                                <i class="fa-solid fa-signature"></i> Signer le contrat
                            </button>
                        </div>
                    </form>
                </div>
            <% } else { %>
                <div class="sign-block">
                    <h2><i class="fa-solid fa-circle-check"></i> Signatures</h2>
                    <div class="sig-already">
                        <div class="sig-card<%= contract.signedAt ? ' done' : ' pending' %>">
                            <div class="sig-card-label">Employé</div>
                            <% if (contract.signedAt) { %>
                                <div class="sig-card-val"><%= contract.signedName %></div>
                                <div class="sig-card-sub"><%= new Date(contract.signedAt).toLocaleString('fr-FR') %></div>
                            <% } else { %>
                                <div class="sig-card-val">En attente</div>
                            <% } %>
                        </div>
                        <div class="sig-card<%= contract.companySignedAt ? ' done' : ' pending' %>">
                            <div class="sig-card-label">Direction</div>
                            <% if (contract.companySignedAt) { %>
                                <div class="sig-card-val"><%= contract.companySignedBy %></div>
                                <div class="sig-card-sub"><%= new Date(contract.companySignedAt).toLocaleString('fr-FR') %><%= contract.companySignedAuto ? ' (auto)' : '' %></div>
                            <% } else { %>
                                <div class="sig-card-val">En attente</div>
                            <% } %>
                        </div>
                        <div class="sig-card<%= contract.lawyerSignedAt ? ' done' : ' pending' %>">
                            <div class="sig-card-label">Avocat</div>
                            <% if (contract.lawyerSignedAt) { %>
                                <div class="sig-card-val"><%= contract.lawyerSignedName %></div>
                                <div class="sig-card-sub"><%= new Date(contract.lawyerSignedAt).toLocaleString('fr-FR') %></div>
                            <% } else { %>
                                <div class="sig-card-val">En attente</div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <% if (contract.status === 'pending') { %>
    <script>
        var form = document.getElementById('sign-form');
        var btn = document.getElementById('btn-sign');
        var accepted = document.getElementById('sign-accepted');
        var nameInput = document.getElementById('sign-name');
        var nameErr = document.getElementById('sign-name-err');

        // Normalisation : accents → ASCII, lowercase, espaces collapsés.
        // Doit rester identique à celle du serveur (services/contracts.js).
        function normalizeName(s) {
            return String(s || '')
                .normalize('NFD').replace(/[̀-ͯ]/g, '')
                .toLowerCase()
                .replace(/\s+/g, ' ')
                .trim();
        }
        var expected = normalizeName(nameInput.getAttribute('data-expected') || '');

        function nameMatches() {
            return normalizeName(nameInput.value) === expected;
        }

        function updateBtn() {
            var typed = nameInput.value.trim();
            var match = nameMatches();
            // Le bandeau d'erreur ne s'affiche qu'après que l'utilisateur ait
            // commencé à taper — pas dès le focus, pour ne pas crier dans le vide.
            if (typed && !match) {
                nameInput.classList.add('invalid');
                nameErr.classList.add('show');
            } else {
                nameInput.classList.remove('invalid');
                nameErr.classList.remove('show');
            }
            btn.disabled = !accepted.checked || !match;
        }
        accepted.addEventListener('change', updateBtn);
        nameInput.addEventListener('input', updateBtn);

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            btn.disabled = true;
            fetch(window.location.pathname + '/sign', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                credentials: 'same-origin',
                body: JSON.stringify({
                    name: nameInput.value.trim(),
                    accepted: accepted.checked,
                }),
            })
            .then(function(r) { return r.json().then(function(d) { return { ok:r.ok, data:d }; }); })
            .then(function(r) {
                if (!r.ok) throw new Error((r.data && r.data.error) || 'Erreur de signature');
                window.location.reload();
            })
            .catch(function(err) {
                alert('Erreur : ' + err.message);
                btn.disabled = false;
            });
        });
    </script>
    <% } %>
</body>
</html>
