generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth ──

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  employeeId Int?     @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())
}

// ── Employés ──

model Employee {
  id               Int       @id @default(autoincrement())
  firstName        String
  lastName         String
  contract         String    @default("CDD") // CDI | CDD
  role             String    @default("Livreur")
  phone            String?
  iban             String?
  discordId        String?   @unique
  channelId        String?
  casierId         String?
  hireDate         DateTime  @default(now())
  endDate          DateTime?
  status           String    @default("active") // active | inactive
  isAdmin          Boolean   @default(false)
  showInTeam       Boolean   @default(true) // visible sur la page publique /equipe
  notes            String?

  // Remplacement : pointe l'employé absent que ce salarié remplace (typique-
  // ment un CDD couvrant une absence). Self-relation + snapshot du nom pour
  // conserver l'information même si l'employé absent est supprimé plus tard.
  replacesId        Int?
  replaces          Employee?  @relation("EmployeeReplacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy        Employee[] @relation("EmployeeReplacement")
  replacesFirstName String?
  replacesLastName  String?

  user             User?
  absences         Absence[]
  expenses         Expense[]
  breakdowns       Breakdown[]
  repatriations    Repatriation[]
  purchases        Purchase[]
  weekStats        WeekStats[]
  specialBonuses   SpecialBonus[]
  contracts        Contract[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ── Véhicules ──

model Vehicle {
  id           Int           @id @default(autoincrement())
  plate        String        @unique
  type         String        @default("Camion") // Camion | Citerne | Autre
  status       String        @default("active") // active | inactive
  maintenances Maintenance[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Maintenance {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date      DateTime
  miles     Int
  notes     String?
  createdAt DateTime @default(now())
}

// ── Achats ──

// DEPRECATED : remplacé par Type + PurchaseTypeConfig. Conservé pendant la
// fenêtre de migration prod (cf. scripts/migrate-unified-types.js).
// Sera supprimé dans le commit de cleanup une fois la migration validée.
model PurchaseType {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  purchases Purchase[]
}

model Purchase {
  id          Int     @id @default(autoincrement())
  week        Int
  // Ancienne FK vers PurchaseType, nullable pendant la migration ; remplacée
  // par typeKey/typeRef ci-dessous. Supprimée lors du cleanup.
  typeId      Int?
  type        PurchaseType? @relation(fields: [typeId], references: [id])
  // Référence par slug stable vers Type.key — résiste aux renommages de label.
  // SetNull à la suppression du Type (par sécurité) ; en pratique on archive
  // plutôt qu'on ne supprime (Type.archived) pour conserver l'historique.
  typeKey     String?
  typeRef     Type?   @relation(fields: [typeKey], references: [key], onDelete: SetNull)
  qty         Float
  unitPrice   Float
  description String
  date        DateTime
  // employeeId pendu (SetNull) à la suppression de l'Employee : on conserve l'achat
  // (dépense entreprise) + le nom snapshot pour l'affichage rétrospectif.
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  createdAt   DateTime     @default(now())
}

// ── Formulaires employé ──

model Absence {
  id           Int      @id @default(autoincrement())
  // SetNull à la suppression de l'Employee : on conserve la soumission historique.
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  week         Int
  year               Int
  type         String   // conge | maladie | accident | perso | autre
  dateStart    DateTime
  dateEnd      DateTime
  justificatif String?  // oui | non | a_venir
  comment      String?
  createdAt    DateTime @default(now())

  @@index([year, week])
}

model Expense {
  id         Int      @id @default(autoincrement())
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  week       Int
  year               Int
  type       String   // slug = Type.key (pas de FK pour conserver les valeurs historiques même si le Type est supprimé)
  amount     Float
  comment    String?
  createdAt  DateTime @default(now())

  @@index([year, week])
}

// DEPRECATED : remplacé par Type + ExpenseTypeConfig. Conservé pendant la
// fenêtre de migration prod (cf. scripts/migrate-unified-types.js).
// Sera supprimé dans le commit de cleanup une fois la migration validée.
model ExpenseType {
  id                   Int      @id @default(autoincrement())
  key                  String   @unique
  label                String
  reimbursementPercent Float    @default(0)
  createdAt            DateTime @default(now())
}

// ── Types unifiés (notes de frais + achats + futurs domaines) ──

// Référentiel unique de "type" partagé entre tous les domaines (Expense, Purchase,
// et plus tard d'autres). Le `key` est un slug immuable utilisé par les tables
// métier (Expense.type, Purchase.typeKey) pour préserver l'historique même si le
// label est renommé. `category` pilote le bucketing sur /admin/statistiques sans
// dépendre du label (lui-même libre).
model Type {
  id        Int      @id @default(autoincrement())
  key       String   @unique             // slug stable, immuable après création
  label     String                       // libellé affiché, librement modifiable
  category  String?                      // VEHICULE | MATIERE_PREMIERE | JURIDIQUE | null = AUTRE
  position  Int      @default(0)         // ordre d'affichage (asc) dans /admin/types
  archived  Boolean  @default(false)     // soft-delete : disparaît des formulaires mais l'historique reste lisible
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseConfig  ExpenseTypeConfig?
  purchaseConfig PurchaseTypeConfig?
  purchases      Purchase[]
}

// Activation du Type côté notes de frais. Présence de la ligne = utilisable dans
// /admin/frais et le formulaire employé /frais. Porte le % de remboursement
// (spécifique au domaine notes de frais).
model ExpenseTypeConfig {
  typeId               Int   @id
  type                 Type  @relation(fields: [typeId], references: [id], onDelete: Cascade)
  reimbursementPercent Float @default(0)
}

// Activation du Type côté achats. Présence de la ligne = utilisable dans
// /admin/achats. Vide pour l'instant — extensible (budget annuel, alerte plafond…).
model PurchaseTypeConfig {
  typeId Int  @id
  type   Type @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

model Breakdown {
  id             Int      @id @default(autoincrement())
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  week           Int
  year               Int
  truckPlate     String?
  tankerPlate    String?
  type           String?  // moteur | pneu | electricite | citerne | freins | accident | autre
  position       String?
  comment        String?
  createdAt      DateTime @default(now())

  @@index([year, week])
}

model Repatriation {
  id           Int      @id @default(autoincrement())
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  week         Int
  year               Int
  truckPlate   String?
  tankerPlate  String?
  fuel         Int?
  departure    String?
  comment      String?
  createdAt    DateTime @default(now())

  @@index([year, week])
}

// ── Stats hebdomadaires ──

// Snapshot figé des stats d'un employé pour une semaine donnée.
// Une fois écrit, ces valeurs ne changent plus même si les taux/règles évoluent.
model WeekStats {
  id                 Int      @id @default(autoincrement())
  // SetNull à la suppression de l'Employee : les stats figées survivent et restent
  // affichables dans /admin/statistiques grâce au snapshot du nom.
  employeeId         Int?
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName  String?
  employeeLastName   String?
  week               Int
  deliveries         Int      @default(0)
  gainEmployee       Float    @default(0)
  gainEnterprise     Float    @default(0)
  points             Int      @default(0)
  rank               Int      @default(0)
  bonusSalary        Float    @default(0)   // Prime de livraisons effectivement versée
  bonusRate          Float    @default(0)   // Taux appliqué (%) pour bonusSalary
  bonusMinDeliveries Int      @default(0)   // Seuil livraisons pour débloquer bonusSalary à l'époque (0 = pas de seuil)
  weeklyDeliveryQuota Int     @default(30)  // Quota affichage livraisons hebdo à l'époque
  tierLevel          Int      @default(0)
  tierPrime          Float    @default(0)   // Prime palier effectivement versée (= base × share)
  tierBasePoints     Int      @default(0)   // Seuil de points du palier à l'époque du freeze
  tierBasePrime      Float    @default(0)   // Prime base du palier à l'époque du freeze
  tierPrimeShare     Float    @default(0)   // Part du podium appliquée à l'époque (0.5/0.3/0.2/0)
  pointsPerGain      Float    @default(1000) // Équivalence $→pts à l'époque
  podiumPrize        Float    @default(0)
  specialBonus       Float    @default(0)
  specialBonusReason String?
  expenseRefund      Float    @default(0)  // Remboursement net des notes de frais
  expenseCost        Float    @default(0)  // Brut des notes de frais (somme amount)
  repatBonus         Float    @default(0)  // = repatCount × repatCostPerEvent × repatReimbursementPercent/100
  repatCount         Int      @default(0)
  repatCostPerEvent  Float    @default(0) // Snapshot à l'époque
  repatReimbursementPercent  Float @default(0) // Snapshot à l'époque
  impoundPenalty     Float    @default(0)  // Net déduit de l'employé = impoundCount × cost - impoundReimbursement
  impoundCount       Int      @default(0)
  impoundCostPerEvent        Float @default(0) // Snapshot à l'époque
  impoundReimbursementPercent Float @default(0) // Snapshot à l'époque
  impoundReimbursement       Float @default(0) // Montant remboursé par l'entreprise (= part portée par l'entreprise)
  primeFinale        Float    @default(0)
  frozenAt           DateTime @default(now())
  year               Int

  @@unique([employeeId, week, year])
  @@index([year, week])
}

// ── Période / Config ──

model Period {
  id         Int      @id @default(autoincrement())
  weekNumber Int
  year               Int
  startDate  DateTime
  endDate    DateTime
  status     String   @default("active") // active | closed
  createdAt  DateTime @default(now())

  @@unique([weekNumber, year])
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// Prime spéciale manuelle attribuée par un admin à un employé pour une semaine donnée.
model SpecialBonus {
  id         Int      @id @default(autoincrement())
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?
  week       Int
  year               Int
  amount     Float
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, week, year])
  @@index([year, week])
}

// ── FAQ ──

// Catégorie de questions affichée comme un groupe accordion côté employé.
// position : ordre d'affichage (asc) — modifiable depuis l'admin.
model FaqCategory {
  id        Int        @id @default(autoincrement())
  name      String
  position  Int        @default(0)
  entries   FaqEntry[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Entrée Q/R. answer est du HTML produit par Quill côté admin (gras, listes,
// liens…). Affiché tel quel côté employé — l'admin est de confiance (panel
// interne, pas de saisie publique).
model FaqEntry {
  id         Int         @id @default(autoincrement())
  categoryId Int
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question   String
  answer     String      // HTML
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId])
}

// ── Compte Gouvernement ──

// Compte unique de surveillance externe (consultation lecture seule des effectifs,
// achats et statistiques). Le mot de passe est stocké en clair : c'est un compte
// de service partagé que l'admin doit pouvoir afficher et communiquer depuis
// /admin/gouv. Singleton applicatif — toujours une seule ligne.
model GovAccount {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Contrats ──

// Template de contrat éditable depuis /admin/contracts (HTML produit par Quill).
// Les placeholders {{firstName}}, {{lastName}}, {{startDate}}, etc. sont remplacés
// au moment de la génération d'un Contract. Un seul template peut être marqué
// `isActive` à la fois — c'est lui qui sert pour toutes les nouvelles générations.
model ContractTemplate {
  id        Int        @id @default(autoincrement())
  name      String
  content   String     // HTML
  // Type de contrat ciblé : "CDI" | "CDD" | null (générique, fallback).
  // À la génération, on cherche d'abord le template actif du même kind que
  // l'employé, puis on retombe sur un template générique si absent.
  kind      String?
  isActive  Boolean    @default(false)
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Instance de contrat liée à un employé. Le HTML rendu (avec valeurs substituées)
// est stocké tel quel dans `htmlSnapshot` : si le template évolue plus tard,
// les contrats déjà émis ne changent pas. Workflow 3 niveaux : employé → entreprise
// → avocat. Tokens uniques pour les liens de signature (employé via Discord casier,
// avocat via lien public protégé par mdp).
model Contract {
  id                Int       @id @default(autoincrement())
  // SetNull à la suppression de l'Employee : on conserve l'historique du contrat
  // grâce au snapshot du nom (cohérent avec les autres tables).
  employeeId        Int?
  employee          Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeFirstName String?
  employeeLastName  String?

  // Template au moment de la génération. SetNull si le template est supprimé.
  templateId        Int?
  template          ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  htmlSnapshot      String              // HTML final figé — source de vérité

  contractKind      String              // CDI | CDD (snapshot au moment de la création)
  startDate         DateTime
  endDate           DateTime?

  // pending | employee-signed | company-signed | signed | cancelled | superseded
  status            String    @default("pending")

  // Signature employé : token utilisé dans le lien Discord casier
  signToken         String    @unique
  signedAt          DateTime?
  signedName        String?
  signedIp          String?
  signedUserAgent   String?

  // Contre-signature entreprise (admin). companySignedBy = nom admin OU "auto".
  companySignedAt   DateTime?
  companySignedBy   String?
  companySignedAuto Boolean   @default(false)

  // Signature avocat (lien public protégé par mdp LawyerAccount). Token généré
  // par l'admin via /admin/contracts/:id (bouton "Envoyer à l'avocat").
  lawyerSignToken   String?   @unique
  lawyerSignedAt    DateTime?
  lawyerSignedName  String?
  lawyerSignedIp    String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

// Compte avocat : singleton applicatif (comme GovAccount) pour protéger le lien
// public de signature avocat. Pas d'username — un mot de passe partagé suffit
// (compte de service, pas une session utilisateur). Mot de passe en clair :
// l'admin doit pouvoir le voir et le communiquer à l'avocat.
model LawyerAccount {
  id        Int      @id @default(autoincrement())
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Logs importés Google Sheets ──

model LogEntry {
  id        Int      @id @default(autoincrement())
  sheetRow  Int      @unique  // Numéro de ligne dans le Google Sheet "FORM" — clé d'idempotence
  type      String   // delivery | invoice | call | garage | duty
  timestamp DateTime
  week      Int
  year               Int
  data      String   // JSON string of parsed fields
  rawData   String   // Original C column value
  createdAt DateTime @default(now())

  @@index([type])
  @@index([year, week])
}
